# 手元で動かすときの設定。このファイルを .env にコピーして埋める（.env は git に入らない）。
# python run.py が起動時に読む。キーは他人に見せない・チャットに貼らない・コミットしない。

# --- 方式 A: 自分の Gemini API キー（AI Studio）。手元の開発用 ---
# キーは https://aistudio.google.com/apikey で作る。
GEMINI_API_KEY=

# 使うモデルの名前。AI Studio のモデル一覧から、速さ優先の Flash 系を選んで入れる。
ZT_MODEL=

# --- 方式 B: Vertex AI（本番と同じ）。使うときは方式 A の GEMINI_API_KEY を空にして、下の # を外す ---
# 認証は `gcloud auth application-default login` で行う。
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# --- 京都市バス・京都バスの便（公共交通オープンデータセンターの開発者サイトの鍵）。空なら便を出さない ---
# 鍵そのものの代わりに、鍵を書いたファイルの場所を ZT_ODPT_KEY_FILE に入れてもよい。
ZT_ODPT_KEY=
# 出典の文に出す問い合わせ先（開発者のメールアドレス）。空なら問い合わせ先の一文を出さない。
ZT_CONTACT=
